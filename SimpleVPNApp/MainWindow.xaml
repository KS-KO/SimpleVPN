<Window x:Class="SimpleVPNApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:SimpleVPNApp.ViewModels"
        xmlns:models="clr-namespace:SimpleVPNApp.Models"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        mc:Ignorable="d"
        Title="SimpleVPN" Height="730" Width="1080" MinHeight="680" MinWidth="980"
        WindowStyle="None" ResizeMode="CanResize" Background="#101117"
        Icon="/Assets/logo.png"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="34"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <tb:TaskbarIcon x:Name="MyNotifyIcon"
                        ToolTipText="{Binding TrayToolTipText}"
                        DoubleClickCommand="{Binding ShowWindowCommand}">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="S" Background="{StaticResource PrimaryBrush}" Foreground="White" FontSize="42" FontWeight="Bold" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Style="{StaticResource TrayContextMenuStyle}">
                    <MenuItem Header="SimpleVPN 열기" Command="{Binding ShowWindowCommand}" Style="{StaticResource TrayMenuItemStyle}"/>
                    <Separator Style="{StaticResource TraySeparatorStyle}"/>
                    <MenuItem Header="VPN 연결 해제" Command="{Binding ToggleConnectionCommand}" IsEnabled="{Binding IsConnected}" Style="{StaticResource TrayMenuItemStyle}"/>
                    <MenuItem Header="프로그램 종료" Command="{Binding ExitAppCommand}" Style="{StaticResource TrayDangerMenuItemStyle}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Border Margin="8" CornerRadius="34" BorderThickness="1.5" BorderBrush="#303446">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#12131A" Offset="0"/>
                    <GradientStop Color="#171A24" Offset="0.45"/>
                    <GradientStop Color="#101117" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" Direction="-90" RenderingBias="Quality" ShadowDepth="8" Opacity="0.45"/>
            </Border.Effect>
        </Border>

        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Background="#232739" CornerRadius="999" Padding="12,6" Margin="0,0,12,0">
                        <TextBlock Text="{Binding SelectedConnectionOption.DisplayName}" Foreground="#C7CBFF" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Border Padding="12,6" CornerRadius="999">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#232739"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="#173328"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#9EA4C7"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Foreground" Value="#8DF0AF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Button Margin="12,0,0,0"
                            Padding="14,6"
                            Click="OpenGuideButton_Click"
                            Background="#1D2233"
                            BorderBrush="#34405A"
                            BorderThickness="1"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1D2233"/>
                                <Setter Property="BorderBrush" Value="#34405A"/>
                                <Setter Property="Foreground" Value="#DCE1FF"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2B3550"/>
                                        <Setter Property="BorderBrush" Value="#6074B8"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="999" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="설치 가이드" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>

                <Button Grid.Column="1" Width="40" Height="40" Click="CloseButton_Click" Background="#1B1E2A" BorderBrush="#303446" BorderThickness="1" ToolTip="트레이로 최소화">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="✕" Foreground="#7B819B" FontSize="16" FontWeight="Bold"/>
                </Button>
            </Grid>

            <Grid Grid.Row="2" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="22" CornerRadius="24">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1A1D2A" Offset="0"/>
                                <GradientStop Color="#1F2440" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="0.85*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="SimpleVPN" Foreground="White" FontSize="34" FontWeight="Bold" FontFamily="Bahnschrift SemiBold"/>
                                <TextBlock Text="Modern private routing, cleaned up for a faster desktop flow." Foreground="#A0A7C7" FontSize="14" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding ConnectionDetails}" Foreground="#D9DCF1" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0"/>

                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#141824" BorderBrush="#343A53" BorderThickness="1" CornerRadius="16" Padding="16,14">
                                        <StackPanel>
                                            <TextBlock Text="Public IP" Foreground="#8F96B8" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PublicIp}" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#141824" BorderBrush="#343A53" BorderThickness="1" CornerRadius="16" Padding="16,14">
                                        <StackPanel>
                                            <TextBlock Text="Server IP" Foreground="#8F96B8" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ConnectedServerIp}" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Button Height="60" Command="{Binding ToggleConnectionCommand}" Margin="0,22,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                            <Setter Property="Background" Value="#5865F2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Background" Value="#F04747"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding ButtonContent}" FontSize="18" FontWeight="Bold"/>
                                </Button>
                            </StackPanel>

                            <Grid Grid.Column="1">
                                <Grid Width="220" Height="220" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse Fill="#1D2235" Width="214" Height="214"/>
                                    <Ellipse StrokeThickness="9" Width="182" Height="182">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Stroke" Value="#3A4160"/>
                                                <Setter Property="Opacity" Value="0.75"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Stroke" Value="#4ADE80"/>
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Border Width="116" Height="116" CornerRadius="24" Background="#11141D" BorderBrush="#C9CEE9" BorderThickness="5">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#5865F2" Opacity="0.25"/>
                                        </Border.Effect>
                                        <Image Source="/Assets/logo.png" Width="78" Height="78" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Padding="16" Background="#181B27" BorderBrush="#2D3144" BorderThickness="1" CornerRadius="20">
                            <StackPanel>
                                <TextBlock Text="VPN Mode" Foreground="#9EA4C7" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Choose the routing engine that fits your setup." Foreground="#7F87A9" FontSize="13" Margin="0,6,0,0"/>
                                <ComboBox ItemsSource="{Binding ConnectionOptions}" SelectedItem="{Binding SelectedConnectionOption}" Background="#24283B" Foreground="White" BorderThickness="0" Padding="10,8" DisplayMemberPath="DisplayName" Margin="0,12,0,0">
                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#24283B"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#5865F2"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#24283B"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="White"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="Transparent">
                                                            <Path Width="10" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 5 6 L 10 0 Z" Fill="#9EA4C7"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ComboBox">
                                                        <Grid>
                                                            <Border x:Name="RootBorder" Background="{TemplateBinding Background}" BorderBrush="#3B3D4F" BorderThickness="1" CornerRadius="12">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="34"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ContentPresenter Grid.Column="0" Margin="12,8,8,8" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" RecognizesAccessKey="True" TextElement.Foreground="White"/>
                                                                    <ToggleButton Grid.Column="1" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"/>
                                                                </Grid>
                                                            </Border>
                                                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                                                <Border Margin="0,6,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="#24283B" BorderBrush="#3B3D4F" BorderThickness="1" CornerRadius="12">
                                                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </Popup>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#5865F2"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Background" Value="#24283B"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Padding" Value="10,8"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ComboBoxItem">
                                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#2E334D"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#5865F2"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ComboBox.Resources>
                                </ComboBox>
                                <TextBlock Text="{Binding SelectedConnectionOption.Description}" Foreground="#A1A8C8" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                <Border Background="#141824" BorderBrush="#343A53" BorderThickness="1" CornerRadius="16" Padding="12" Margin="0,12,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChinaModeSelected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="China Mode Quick Note" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="설정 입력은 오른쪽 `China Mode Setup` 패널에서 한 화면으로 정리되어 표시됩니다." Foreground="#95A0C6" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        <Border Background="#101524" BorderBrush="#2D3754" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,12,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="상태" Foreground="#8F96B8" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="  •  " Foreground="#56607D" FontSize="11"/>
                                                <TextBlock Text="{Binding ChinaModeState}" Foreground="#D8DCFF" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding OutlineProvisionStatus}" Foreground="#C7CBFF" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SelectedConnectionOption.SetupHint}" Foreground="#7DE7A0" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Padding="16" Background="#181B27" BorderBrush="#2D3144" BorderThickness="1" CornerRadius="20">
                            <StackPanel>
                                <TextBlock Text="Recent VPN Status" Foreground="#9EA4C7" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ConnectionDetails}" Foreground="White" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

            <Border Grid.Row="2" Grid.Column="2" Padding="18" Background="#181B27" BorderBrush="#2D3144" BorderThickness="1" CornerRadius="24">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChinaModeSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{Binding ServerLibraryTitle}" Foreground="White" FontSize="20" FontWeight="Bold" FontFamily="Bahnschrift SemiBold"/>
                                <TextBlock Text="{Binding ServerLibrarySubtitle}" Foreground="#8590B4" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding FetchServersCommand}"
                                    Background="#24283B"
                                    BorderBrush="#38405C"
                                    BorderThickness="1"
                                    Padding="14,8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Background" Value="#24283B"/>
                                        <Setter Property="BorderBrush" Value="#38405C"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Padding" Value="14,8"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChinaModeSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="12"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="서버 목록 갱신" Foreground="#D8DCFF" FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource ServerListBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChinaModeSelected}" Value="True">
                                            <Setter Property="Opacity" Value="0.35"/>
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:VpnServer}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Opacity="0.92">
                                            <TextBlock Text="{Binding CountryShort}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HostName}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding CountryLong}" Foreground="#8E95B7" FontSize="12"/>
                                                <TextBlock Text="  •  " Foreground="#59607D" FontSize="12"/>
                                                <TextBlock Text="{Binding Ping}" Foreground="#7DE7A0" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text=" ms" Foreground="#8E95B7" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Speed}" Foreground="#C7CBFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            <TextBlock Text="Mbps" Foreground="#6E7698" FontSize="11" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="1"
                                Background="#0F1220"
                                BorderBrush="#303446"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16"
                                Margin="0,64,0,0"
                                VerticalAlignment="Top">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChinaModeSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="China Mode Notice" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="중국 환경에서는 공개 VPN Gate 서버보다 본인 소유 Outline Access Key 사용을 권장합니다." Foreground="#A1A8C8" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="China Mode는 `SimpleVPNApp\Runtime\sing-box\sing-box.exe`를 직접 실행합니다. 별도 Outline Client 설치는 필요하지 않습니다." Foreground="#7F87A9" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,18,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ProgressBar IsIndeterminate="True" Height="3" Background="#0F1220" BorderThickness="0" Foreground="{StaticResource PrimaryBrush}"/>
                        </Grid>
                    </Grid>
            </Border>

            <Border Grid.Row="2" Grid.Column="2" Padding="18" Background="#181B27" BorderBrush="#2D3144" BorderThickness="1" CornerRadius="24">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChinaModeSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="China Mode Setup" Foreground="White" FontSize="20" FontWeight="Bold" FontFamily="Bahnschrift SemiBold"/>
                        <TextBlock Text="기존 Outline 서버 관리 정보와 Access Key 생성을 한 화면에서 진행합니다." Foreground="#8590B4" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding OutlineApiUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0F1220"
                                 Foreground="White"
                                 BorderBrush="#38405C"
                                 BorderThickness="1"
                                 Padding="12,10"
                                 CaretBrush="White"
                                 ToolTip="https://1.2.3.4:1234/SecretPath 형식의 apiUrl"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding OutlineCertSha256, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0F1220"
                                 Foreground="White"
                                 BorderBrush="#38405C"
                                 BorderThickness="1"
                                 Padding="12,10"
                                 CaretBrush="White"
                                 ToolTip="certSha256 값"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding ChinaModeAccessKey, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0F1220"
                                 Foreground="White"
                                 BorderBrush="#38405C"
                                 BorderThickness="1"
                                 Padding="12,10"
                                 CaretBrush="White"
                                 ToolTip="ss:// 형식의 Outline Access Key"/>
                        <Button Grid.Column="2" Command="{Binding GenerateAccessKeyFromExistingServerCommand}" Height="42">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                    <Setter Property="Background" Value="#32406C"/>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="키 생성" FontSize="13" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding OutlineSshHost, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0F1220"
                                 Foreground="White"
                                 BorderBrush="#38405C"
                                 BorderThickness="1"
                                 Padding="12,10"
                                 CaretBrush="White"
                                 ToolTip="SSH 접속 호스트"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding OutlineSshUser, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0F1220"
                                 Foreground="White"
                                 BorderBrush="#38405C"
                                 BorderThickness="1"
                                 Padding="12,10"
                                 CaretBrush="White"
                                 ToolTip="SSH 사용자"/>
                        <TextBox Grid.Column="4"
                                 Text="{Binding OutlineSshKeyPath, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0F1220"
                                 Foreground="White"
                                 BorderBrush="#38405C"
                                 BorderThickness="1"
                                 Padding="12,10"
                                 CaretBrush="White"
                                 ToolTip="SSH 개인키 경로"/>
                        <Button Grid.Column="6" Command="{Binding LoadExistingServerAccessInfoCommand}" Height="42">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                    <Setter Property="Background" Value="#253B63"/>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="자동 읽기" FontSize="13" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>

                    <Border Grid.Row="4" Background="#0F1220" BorderBrush="#303446" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="China Mode Summary" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding OutlineProvisionStatus}" Foreground="#C7CBFF" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ConnectionDetails}" Foreground="#D7DCF5" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedConnectionOption.SetupHint}" Foreground="#7DE7A0" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
