<Window x:Class="SimpleVPNApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:helpers="clr-namespace:SimpleVPNApp.Helpers"
        xmlns:vm="clr-namespace:SimpleVPNApp.ViewModels"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        mc:Ignorable="d"
        Title="SimpleVPN" Height="750" Width="1100" MinHeight="700" MinWidth="1000"
        WindowStyle="None" ResizeMode="CanResize" Background="#101117"
        Icon="/Assets/logo.png" WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" CornerRadius="34" GlassFrameThickness="0" ResizeBorderThickness="8" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.DataContext><vm:MainViewModel /></Window.DataContext>
    <Grid>
        <tb:TaskbarIcon x:Name="MyNotifyIcon" ToolTipText="{Binding TrayToolTipText}" DoubleClickCommand="{Binding ShowWindowCommand}">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="S" Background="{StaticResource PrimaryBrush}" Foreground="White" FontSize="42" FontWeight="Bold" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Style="{StaticResource TrayContextMenuStyle}">
                    <MenuItem Header="열기" Command="{Binding ShowWindowCommand}" Style="{StaticResource TrayMenuItemStyle}"/>
                    <Separator Style="{StaticResource TraySeparatorStyle}"/>
                    <MenuItem Header="연결하기" Command="{Binding ToggleConnectionCommand}" Style="{StaticResource TrayMenuItemStyle}" 
                              Visibility="{Binding IsConnected, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    <MenuItem Header="연결 해제" Command="{Binding ToggleConnectionCommand}" Style="{StaticResource TrayMenuItemStyle}" 
                              Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Separator Style="{StaticResource TraySeparatorStyle}"/>
                    <MenuItem Header="종료" Command="{Binding ExitAppCommand}" Style="{StaticResource TrayDangerMenuItemStyle}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
        <Border Margin="8" CornerRadius="34" BorderThickness="1.5" BorderBrush="#303446" Background="#12131A"/>
        <Grid Margin="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2.15*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            
            <!-- Header Grid -->
            <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#232739" CornerRadius="999" Padding="12,6" Margin="0,0,12,0"><TextBlock Text="{Binding SelectedConnectionOption.DisplayName}" Foreground="#C7CBFF" FontSize="12" FontWeight="SemiBold"/></Border>
                    <Border Background="#232739" Padding="12,6" CornerRadius="999"><TextBlock Text="{Binding StatusMessage}" Foreground="#9EA4C7" FontSize="12" FontWeight="SemiBold"/></Border>
                    <Button Margin="12,0,0,0" Style="{StaticResource GhostButtonStyle}" Click="OpenGuideButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="설치 가이드" FontSize="12" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
                <Button Grid.Column="1" Width="40" Height="40" Click="CloseButton_Click" Background="#1B1E2A" BorderBrush="#303446" BorderThickness="1" ToolTip="트레이로 최소화"><TextBlock Text="×" Foreground="#7B819B" FontSize="16" FontWeight="Bold"/></Button>
            </Grid>

            <!-- Left Panel -->
            <Border Grid.Row="2" Grid.Column="0" Padding="22" CornerRadius="28" Background="#1A1D2A">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    
                    <!-- Hero Section -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SimpleVPN" Foreground="White" FontSize="36" FontWeight="Bold" FontFamily="Bahnschrift SemiBold"/>
                            <TextBlock Text="Premium private routing, optimized for speed." Foreground="#A0A7C7" FontSize="14" Margin="0,8,0,0"/>
                            <Grid Margin="0,24,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#141824" BorderBrush="#343A53" BorderThickness="1" CornerRadius="18" Padding="18,16"><StackPanel><TextBlock Text="Public IP" Foreground="#8F96B8" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding PublicIp}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
                                <Border Grid.Column="2" Background="#141824" BorderBrush="#343A53" BorderThickness="1" CornerRadius="18" Padding="18,16"><StackPanel><TextBlock Text="Duration" Foreground="#8F96B8" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding ConnectionDurationText}" Foreground="{StaticResource PrimaryBrush}" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
                            </Grid>
                            
                            <!-- Real-time Stats Dashboard -->
                            <Border Margin="0,16,0,0" Background="#131622" BorderBrush="#2D334D" BorderThickness="1" CornerRadius="20" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="DOWNLOAD" Foreground="#7F87A9" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding DownloadSpeedText}" Foreground="#4ADE80" FontSize="18" FontWeight="Bold" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalReceivedText}" Foreground="#5F6789" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Rectangle Grid.Column="1" Fill="#2D334D" Width="1" Margin="10,4"/>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="UPLOAD" Foreground="#7F87A9" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding UploadSpeedText}" Foreground="{StaticResource PrimaryBrush}" FontSize="18" FontWeight="Bold" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalSentText}" Foreground="#5F6789" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Button Height="64" Command="{Binding ToggleConnectionCommand}" Margin="0,24,0,0" Style="{StaticResource ModernButtonStyle}" Background="{StaticResource PrimaryBrush}"><TextBlock Text="{Binding ButtonContent}" FontSize="18" FontWeight="Bold"/></Button>
                        </StackPanel>
                        <Border Grid.Column="1" Width="130" Height="130" CornerRadius="28" Background="#11141D" BorderBrush="#343A53" BorderThickness="4" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="/Assets/logo.png" Width="84" Height="84"/></Border>
                    </Grid>
                    
                    <!-- Connection Mode Toggle -->
                    <Grid Grid.Row="2">
                        <Border Padding="20" Background="#181B27" BorderBrush="#2D3144" BorderThickness="1" CornerRadius="24">
                            <StackPanel>
                                <TextBlock Text="VPN Mode" Foreground="White" FontSize="18" FontWeight="Bold" FontFamily="Bahnschrift SemiBold"/>
                                <TextBlock Text="Choose your preferred engine." Foreground="#7F87A9" FontSize="12" Margin="0,4,0,0"/>
                                <ComboBox ItemsSource="{Binding ConnectionOptions}" SelectedItem="{Binding SelectedConnectionOption}" DisplayMemberPath="DisplayName" Style="{StaticResource ModernComboBoxStyle}" Margin="0,16,0,0"/>
                                <CheckBox IsChecked="{Binding IsKillSwitchEnabled}" Margin="0,14,0,0" Style="{StaticResource ModernCheckBoxStyle}" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical" Margin="8,0,0,0">
                                        <TextBlock Text="Firewall Kill Switch" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="VPN 연결이 끊기면 모든 네트워크 트래픽을 차단합니다." Foreground="#7F87A9" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Text="{Binding SelectedConnectionOption.Description}" Foreground="#A1A8C8" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"/>
                                <Border Background="#141824" BorderBrush="#343A53" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,16,0,0">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsChinaModeSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <StackPanel><TextBlock Text="China Mode Active" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="설정은 오른쪽 패널에서 관리하세요." Foreground="#95A0C6" FontSize="12" Margin="0,6,0,0"/><TextBlock Text="{Binding ChinaModeState}" Foreground="White" FontSize="12" Margin="0,8,0,0" FontWeight="Bold"/></StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right Panel -->
            <Border Grid.Row="2" Grid.Column="2" Padding="20" CornerRadius="28" Background="#181B27" BorderBrush="#2D3144" BorderThickness="1">
                <Grid>
                    <!-- Server Library View -->
                    <Grid Visibility="{Binding IsChinaModeSelected, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Server Library" Foreground="White" FontSize="20" FontWeight="Bold" FontFamily="Bahnschrift SemiBold"/>
                                <TextBlock Text="Fastest available public nodes &amp; custom servers." Foreground="#8590B4" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding SmartConnectCommand}" Style="{StaticResource GhostButtonStyle}" BorderThickness="0" Padding="12,6" ToolTip="Smart Connect (Best Latency)">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="⚡ Smart" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11"/></StackPanel>
                                </Button>
                                <Button Command="{Binding RefreshPingCommand}" Style="{StaticResource GhostButtonStyle}" BorderThickness="0" Margin="6,0,0,0" Padding="8,4" ToolTip="Test Latency">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#7F87A9" FontSize="14" Visibility="{Binding IsTestingPing, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                </Button>
                                <Button Command="{Binding FetchServersCommand}" Style="{StaticResource GhostButtonStyle}" BorderThickness="0" Margin="4,0,0,0" Padding="8,4" ToolTip="Refresh List">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#7F87A9" FontSize="14" Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Add Custom Server Bar -->
                        <Border Grid.Row="1" Background="#141824" BorderBrush="#2D3144" BorderThickness="1" CornerRadius="12" Padding="8,4" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewCustomServerName, UpdateSourceTrigger=PropertyChanged}" Tag="Server Name" Background="Transparent" Foreground="White" BorderThickness="0" Padding="8,6" VerticalContentAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding NewCustomServerIp, UpdateSourceTrigger=PropertyChanged}" Tag="IP Address" Background="Transparent" Foreground="White" BorderThickness="0" Padding="8,6" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="2" Command="{Binding AddCustomServerCommand}" Style="{StaticResource ModernButtonStyle}" Width="32" Height="32" Padding="0">
                                    <TextBlock Text="+" FontSize="18" FontWeight="Bold" Margin="0,-2,0,0"/>
                                </Button>
                            </Grid>
                        </Border>

                        <ListBox x:Name="ServerNodesList" Grid.Row="3" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" Style="{StaticResource ServerListBoxStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,4">
                                        <Grid.ContextMenu>
                                            <ContextMenu Style="{StaticResource TrayContextMenuStyle}">
                                                <MenuItem Header="China Mode로 IP 복사" 
                                                          Command="{Binding Path=DataContext.CopySelectedServerIpToChinaModeCommand, Source={x:Reference ServerNodesList}}"
                                                          CommandParameter="{Binding}"
                                                          Style="{StaticResource TrayMenuItemStyle}"/>
                                                <Separator Style="{StaticResource TraySeparatorStyle}"/>
                                                <MenuItem Header="라이브러리에서 삭제" 
                                                          Command="{Binding Path=DataContext.RemoveCustomServerCommand, Source={x:Reference ServerNodesList}}"
                                                          CommandParameter="{Binding}"
                                                          Style="{StaticResource TrayDangerMenuItemStyle}"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="#2E334D" CornerRadius="8" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="{Binding CountryShort}" Foreground="White" FontWeight="Bold" FontSize="11"/></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding HostName}" Foreground="White" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding IP}" Foreground="#8F96B8" FontSize="10" Margin="0,2,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="{Binding Ping, StringFormat={}{0}ms}" Foreground="#4ADE80" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/><TextBlock Text="{Binding Speed, Converter={StaticResource SpeedConverter}}" Foreground="#A0A7C7" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0"/></StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- China Mode Setup View -->
                    <ScrollViewer Visibility="{Binding IsChinaModeSelected, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="China Mode Setup" Foreground="White" FontSize="20" FontWeight="Bold" FontFamily="Bahnschrift SemiBold"/>
                            <TextBlock Text="Custom configuration for restricted networks." Foreground="#8590B4" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            
                            <!-- Profile Slots -->
                            <Border Background="#0F1220" BorderBrush="#303446" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Saved Profiles" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding SavedChinaProfiles}" SelectedItem="{Binding SelectedSavedChinaProfile}" DisplayMemberPath="Name" Style="{StaticResource ModernComboBoxStyle}"/>
                                        <Button Grid.Column="2" Command="{Binding CreateChinaProfileSlotCommand}" Style="{StaticResource GhostButtonStyle}" Padding="10,6"><TextBlock Text="New" FontSize="11"/></Button>
                                        <Button Grid.Column="4" Command="{Binding DeleteChinaProfileSlotCommand}" Style="{StaticResource GhostButtonStyle}" Padding="10,6"><TextBlock Text="Del" FontSize="11"/></Button>
                                    </Grid>
                                    <!-- Slot Name for Saving -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding ChinaModeProfileName}" Background="#141824" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10" SelectionBrush="{StaticResource PrimaryBrush}"/>
                                        <Button Grid.Column="2" Command="{Binding SaveChinaProfileSlotCommand}" Style="{StaticResource ModernButtonStyle}" Height="40" Padding="16,0"><TextBlock Text="슬롯 저장" FontSize="12" FontWeight="Bold"/></Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Protocol Type Selector -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding ChinaModeProfiles}" SelectedItem="{Binding SelectedChinaModeProfile}" DisplayMemberPath="DisplayName" Style="{StaticResource ModernComboBoxStyle}"/>
                                <Button Grid.Column="2" Command="{Binding TestChinaProfileCommand}" Style="{StaticResource GhostButtonStyle}" Padding="12,8"><TextBlock Text="설전 테스트" FontWeight="Bold"/></Button>
                            </Grid>

                            <!-- Protocol Specific Fields -->
                            <!-- 1. Outline Fields -->
                            <StackPanel Margin="0,16,0,0">
                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOutlineProfileSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <TextBlock Text="Outline Configuration" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <!-- SSH Remote Provisioning for Outline -->
                                <Border Background="#0F1220" BorderBrush="#343A53" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Remote Server Admin (SSH)" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                                        
                                        <!-- Known Hosts Dropdown -->
                                        <ComboBox ItemsSource="{Binding KnownSshHosts}" SelectedItem="{Binding SelectedKnownSshHost}" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,10" Visibility="{Binding KnownSshHosts.Count, Converter={StaticResource IntToVisibilityConverter}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="12"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding OutlineSshHost, UpdateSourceTrigger=PropertyChanged}" Tag="SSH Host (IP)" Background="#141824" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10" Margin="0,0,0,8"/>
                                            <TextBox Grid.Column="2" Text="{Binding OutlineSshUser, UpdateSourceTrigger=PropertyChanged}" Width="100" Tag="User" Background="#141824" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10" Margin="0,0,0,8"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding OutlineSshKeyPath, UpdateSourceTrigger=PropertyChanged}" Tag="SSH Key Path (.pem / .key)" Background="#141824" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/>
                                            <Button Grid.Column="1" Command="{Binding BrowseSshKeyCommand}" Style="{StaticResource GhostButtonStyle}" BorderThickness="1" BorderBrush="#38405C" Margin="4,0,0,0" ToolTip="Browse Key File"><TextBlock Text="📁" FontSize="12"/></Button>
                                            <Button Grid.Column="3" Command="{Binding BootstrapOutlineServerCommand}" Style="{StaticResource ModernButtonStyle}" Height="40" Padding="16,0" Background="{StaticResource PrimaryBrush}"><TextBlock Text="서버 새로 설치" FontSize="12" FontWeight="Bold"/></Button>
                                        </Grid>
                                        <Button HorizontalAlignment="Right" Command="{Binding LoadExistingServerAccessInfoCommand}" Style="{StaticResource GhostButtonStyle}" Padding="12,6"><TextBlock Text="기존 access.txt 정보 읽어오기" FontSize="11" Foreground="#9EA4C7"/></Button>
                                        <TextBlock Text="{Binding OutlineProvisionStatus}" Foreground="#7F87A9" FontSize="11" Margin="2,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Manual Configuration" Foreground="#A1A8C8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding OutlineApiUrl, UpdateSourceTrigger=PropertyChanged}" Tag="API URL" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10" Margin="0,0,0,10"/>
                                    <TextBox Grid.Column="2" Text="{Binding OutlineCertSha256, UpdateSourceTrigger=PropertyChanged}" Tag="Cert SHA256" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10" Margin="0,0,0,10"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ChinaModeAccessKey, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/>
                                    <Button Grid.Column="2" Command="{Binding GenerateAccessKeyFromExistingServerCommand}" Style="{StaticResource GhostButtonStyle}" Padding="12,0"><TextBlock Text="키 생성" FontSize="12"/></Button>
                                </Grid>
                            </StackPanel>

                            <!-- 2. VLESS REALITY Fields -->
                            <StackPanel Margin="0,16,0,0">
                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsVlessRealityProfileSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <TextBlock Text="VLESS Reality Configuration" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                
                                <!-- SSH Remote Provisioning for Reality -->
                                <Border Background="#0F1220" BorderBrush="#343A53" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Remote Server Auto-Provision (SSH)" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                                        
                                        <!-- Known Hosts Dropdown -->
                                        <ComboBox ItemsSource="{Binding KnownSshHosts}" SelectedItem="{Binding SelectedKnownSshHost}" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,10" Visibility="{Binding KnownSshHosts.Count, Converter={StaticResource IntToVisibilityConverter}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="12"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding OutlineSshHost, UpdateSourceTrigger=PropertyChanged}" Tag="SSH Host (IP)" Background="#141824" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10" Margin="0,0,0,8"/>
                                            <TextBox Grid.Column="2" Text="{Binding OutlineSshUser, UpdateSourceTrigger=PropertyChanged}" Width="100" Tag="User" Background="#141824" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10" Margin="0,0,0,8"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding OutlineSshKeyPath, UpdateSourceTrigger=PropertyChanged}" Tag="SSH Key Path (.pem / .key)" Background="#141824" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/>
                                            <Button Grid.Column="1" Command="{Binding BrowseSshKeyCommand}" Style="{StaticResource GhostButtonStyle}" BorderThickness="1" BorderBrush="#38405C" Margin="4,0,0,0" ToolTip="Browse Key File"><TextBlock Text="📁" FontSize="12"/></Button>
                                            <Button Grid.Column="3" Command="{Binding ProvisionRealityServerCommand}" Style="{StaticResource ModernButtonStyle}" Height="40" Padding="16,0" Background="{StaticResource PrimaryBrush}"><TextBlock Text="서버 자동 구축" FontSize="12" FontWeight="Bold"/></Button>
                                        </Grid>
                                        <TextBlock Text="{Binding OutlineProvisionStatus}" Foreground="#7F87A9" FontSize="11" Margin="2,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Manual Configuration" Foreground="#A1A8C8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding VlessRealityServer, UpdateSourceTrigger=PropertyChanged}" Tag="Server" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10" Margin="0,0,0,10"/>
                                    <TextBox Grid.Column="2" Text="{Binding VlessRealityPort, UpdateSourceTrigger=PropertyChanged}" Tag="Port" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10" Margin="0,0,0,10"/>
                                </Grid>
                                <TextBox Text="{Binding VlessRealityUuid, UpdateSourceTrigger=PropertyChanged}" Tag="UUID" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding VlessRealityPublicKey, UpdateSourceTrigger=PropertyChanged}" Tag="Public Key" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding VlessRealityServerName, UpdateSourceTrigger=PropertyChanged}" Tag="SNI" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/>
                                    <TextBox Grid.Column="2" Text="{Binding VlessRealityShortId, UpdateSourceTrigger=PropertyChanged}" Tag="Short ID" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/>
                                </Grid>
                            </StackPanel>

                            <!-- 3. Trojan TLS Fields -->
                            <StackPanel Margin="0,16,0,0">
                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTrojanProfileSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <TextBlock Text="Trojan TLS Configuration" Foreground="#A1A8C8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding TrojanServer, UpdateSourceTrigger=PropertyChanged}" Tag="Server" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10" Margin="0,0,0,10"/>
                                    <TextBox Grid.Column="2" Text="{Binding TrojanPort, UpdateSourceTrigger=PropertyChanged}" Tag="Port" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10" Margin="0,0,0,10"/>
                                </Grid>
                                <TextBox Text="{Binding TrojanPassword, UpdateSourceTrigger=PropertyChanged}" Tag="Password" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding TrojanServerName, UpdateSourceTrigger=PropertyChanged}" Tag="SNI" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/>
                            </StackPanel>
                            
                            <Border Background="#0F1220" BorderBrush="#303446" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="Summary Details" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ChinaModeProfileHint}" Foreground="#7DE7A0" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ConnectionDetails}" Foreground="#D7DCF5" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
