<Window x:Class="SimpleVPNApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleVPNApp"
        xmlns:vm="clr-namespace:SimpleVPNApp.ViewModels"
        xmlns:models="clr-namespace:SimpleVPNApp.Models"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        mc:Ignorable="d"
        Title="SimpleVPN" Height="700" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Icon="/Assets/logo.png"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <!-- Tray Icon Integration (H.NotifyIcon.Wpf) -->
        <tb:TaskbarIcon x:Name="MyNotifyIcon"
                        ToolTipText="{Binding TrayToolTipText}"
                        DoubleClickCommand="{Binding ShowWindowCommand}">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource
                    Text="S"
                    Background="{StaticResource PrimaryBrush}"
                    Foreground="White"
                    FontSize="42"
                    FontWeight="Bold" />
            </tb:TaskbarIcon.IconSource>
            <!-- Tray Context Menu -->
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Style="{StaticResource TrayContextMenuStyle}">
                    <MenuItem Header="Open SimpleVPN"
                              Command="{Binding ShowWindowCommand}"
                              Style="{StaticResource TrayMenuItemStyle}"/>
                    <Separator Style="{StaticResource TraySeparatorStyle}"/>
                    <MenuItem Header="Disconnect VPN"
                              Command="{Binding ToggleConnectionCommand}"
                              IsEnabled="{Binding IsConnected}"
                              Style="{StaticResource TrayMenuItemStyle}"/>
                    <MenuItem Header="Exit Application"
                              Command="{Binding ExitAppCommand}"
                              Style="{StaticResource TrayDangerMenuItemStyle}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Background Layer -->
        <Border CornerRadius="30" Background="#14151B" BorderBrush="#3B3D4F" BorderThickness="1.5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Direction="-90" RenderingBias="Quality" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>
        </Border>

        <!-- Main Content Inner -->
        <DockPanel Margin="25">
            <!-- Header & Exit Buttons -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,25">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="SimpleVPN" FontSize="26" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI Semibold"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#898AA8" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Foreground" Value="#4ADE80"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Top Right Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <!-- Minimize Button logic (custom) -->
                    <Button Width="32" Height="32" Click="CloseButton_Click" Background="Transparent" BorderThickness="0" ToolTip="트레이로 최소화">
                        <TextBlock Text="✕" Foreground="#4A4B5F" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Visual Indicator (Logo Image) -->
            <Grid DockPanel.Dock="Top" Height="140" VerticalAlignment="Top" Margin="0,10">
                <Ellipse Stroke="#2E303E" StrokeThickness="6" Width="110" Height="110">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Stroke" Value="#4ADE80"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                
                <!-- Sunflower Logo Image -->
                <Image Source="/Assets/logo.png" Width="80" Height="80" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Opacity" Value="0.8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="10" Direction="-90" ShadowDepth="0" Opacity="0.3"/>
                    </Image.Effect>
                </Image>
            </Grid>

            <Border DockPanel.Dock="Top"
                    Margin="0,6,0,10"
                    Padding="14,12"
                    Background="#1B1D27"
                    BorderBrush="#2D3140"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock Text="Recent VPN Status"
                               Foreground="#9EA4C7"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding ConnectionDetails}"
                               Foreground="White"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top"
                    Margin="0,0,0,10"
                    Padding="14,12"
                    Background="#1B1D27"
                    BorderBrush="#2D3140"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Public IP"
                                   Foreground="#9EA4C7"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding PublicIp}"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Server IP"
                                   Foreground="#9EA4C7"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding ConnectedServerIp}"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top"
                    Margin="0,0,0,10"
                    Padding="14,12"
                    Background="#1B1D27"
                    BorderBrush="#2D3140"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock Text="VPN Mode"
                               Foreground="#9EA4C7"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding ConnectionOptions}"
                              SelectedItem="{Binding SelectedConnectionOption}"
                              Background="#24283B"
                              Foreground="White"
                              BorderThickness="0"
                              Padding="10,8"
                              DisplayMemberPath="DisplayName">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#24283B"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#5865F2"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#24283B"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="White"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <Path Width="10"
                                                      Height="6"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 5 6 L 10 0 Z"
                                                      Fill="#9EA4C7"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBox">
                                            <Grid>
                                                <Border x:Name="RootBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="#3B3D4F"
                                                        BorderThickness="1"
                                                        CornerRadius="10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="34"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ContentPresenter Grid.Column="0"
                                                                          Margin="12,8,8,8"
                                                                          VerticalAlignment="Center"
                                                                          HorizontalAlignment="Left"
                                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                                          RecognizesAccessKey="True"
                                                                          TextElement.Foreground="White"/>
                                                        <ToggleButton Grid.Column="1"
                                                                      Focusable="False"
                                                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                      ClickMode="Press"/>
                                                    </Grid>
                                                </Border>
                                                <Popup Name="Popup"
                                                       Placement="Bottom"
                                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                                       AllowsTransparency="True"
                                                       Focusable="False"
                                                       PopupAnimation="Slide">
                                                    <Border Margin="0,6,0,0"
                                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                                            Background="#24283B"
                                                            BorderBrush="#3B3D4F"
                                                            BorderThickness="1"
                                                            CornerRadius="10">
                                                        <ScrollViewer Margin="4"
                                                                      SnapsToDevicePixels="True">
                                                            <StackPanel IsItemsHost="True"
                                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                        </ScrollViewer>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="RootBorder" Property="BorderBrush" Value="#5865F2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#24283B"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#2E334D"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#5865F2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.Resources>
                    </ComboBox>
                    <TextBlock Text="{Binding SelectedConnectionOption.Description}"
                               Foreground="#898AA8"
                               FontSize="11"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Server Selection -->
            <Grid Margin="0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Available Free Servers" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                    <Button Command="{Binding FetchServersCommand}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right">
                        <TextBlock Text="Refresh List" Foreground="{StaticResource PrimaryBrush}" FontSize="12" TextDecorations="Underline"/>
                    </Button>
                </DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" Style="{StaticResource ServerListBoxStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:VpnServer}">
                            <DockPanel LastChildFill="True">
                                <Border Background="{StaticResource PrimaryBrush}" CornerRadius="6" VerticalAlignment="Center" Width="30" Height="30" Margin="0,0,12,0" Opacity="0.8">
                                    <TextBlock Text="{Binding CountryShort}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HostName}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Ping}" Foreground="#4ADE80" FontSize="11"/><TextBlock Text=" ms" Foreground="#4A4B5F" FontSize="11" Margin="2,0,10,0"/>
                                        <TextBlock Text="{Binding Speed}" Foreground="#898AA8" FontSize="11" /><TextBlock Text=" Mbps" Foreground="#4A4B5F" FontSize="11" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="📶" Foreground="#3B3D4F" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Loading ProgressBar -->
            <Grid DockPanel.Dock="Top" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar IsIndeterminate="True" Height="2" Background="Transparent" BorderThickness="0" Foreground="{StaticResource PrimaryBrush}"/>
            </Grid>

            <!-- Bottom Button -->
            <Button DockPanel.Dock="Bottom" Height="64" Command="{Binding ToggleConnectionCommand}" Margin="0,15,0,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{Binding ButtonContent}" FontSize="18" FontWeight="Bold"/>
            </Button>
        </DockPanel>
    </Grid>
</Window>
