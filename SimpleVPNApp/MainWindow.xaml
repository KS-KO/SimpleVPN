<Window x:Class="SimpleVPNApp.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:helpers="clr-namespace:SimpleVPNApp.Helpers"
 xmlns:vm="clr-namespace:SimpleVPNApp.ViewModels"
 xmlns:models="clr-namespace:SimpleVPNApp.Models"
 xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
 mc:Ignorable="d"
 Title="SimpleVPN" Height="730" Width="1080" MinHeight="680" MinWidth="980"
 WindowStyle="None" ResizeMode="CanResize" Background="#101117"
 Icon="/Assets/logo.png" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="44" CornerRadius="34" GlassFrameThickness="0" ResizeBorderThickness="8" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Window.DataContext><vm:MainViewModel /></Window.DataContext>
 <Grid>
  <tb:TaskbarIcon x:Name="MyNotifyIcon" ToolTipText="{Binding TrayToolTipText}" DoubleClickCommand="{Binding ShowWindowCommand}">
   <tb:TaskbarIcon.IconSource><tb:GeneratedIconSource Text="S" Background="{StaticResource PrimaryBrush}" Foreground="White" FontSize="42" FontWeight="Bold" /></tb:TaskbarIcon.IconSource>
  </tb:TaskbarIcon>
  <Border Margin="8" CornerRadius="34" BorderThickness="1.5" BorderBrush="#303446" Background="#12131A"/>
  <Grid Margin="24">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2.15*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,6">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal">
     <Border Background="#232739" CornerRadius="999" Padding="12,6" Margin="0,0,12,0"><TextBlock Text="{Binding SelectedConnectionOption.DisplayName}" Foreground="#C7CBFF" FontSize="12" FontWeight="SemiBold"/></Border>
     <Border Background="#232739" Padding="12,6" CornerRadius="999"><TextBlock Text="{Binding StatusMessage}" Foreground="#9EA4C7" FontSize="12" FontWeight="SemiBold"/></Border>
     <Button Margin="12,0,0,0" Padding="14,6" Click="OpenGuideButton_Click" Background="#1D2233" BorderBrush="#34405A" BorderThickness="1" shell:WindowChrome.IsHitTestVisibleInChrome="True"><TextBlock Text="설치 가이드" Foreground="#DCE1FF" FontSize="12" FontWeight="SemiBold"/></Button>
    </StackPanel>
    <Button Grid.Column="1" Width="40" Height="40" Click="CloseButton_Click" Background="#1B1E2A" BorderBrush="#303446" BorderThickness="1" ToolTip="트레이로 최소화"><TextBlock Text="×" Foreground="#7B819B" FontSize="16" FontWeight="Bold"/></Button>
   </Grid>
   <Border Grid.Row="2" Grid.Column="0" Padding="22" CornerRadius="24" Background="#1A1D2A">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="SimpleVPN" Foreground="White" FontSize="34" FontWeight="Bold" FontFamily="Bahnschrift SemiBold"/>
       <TextBlock Text="Modern private routing, cleaned up for a faster desktop flow." Foreground="#A0A7C7" FontSize="14" Margin="0,8,0,0"/>
       <TextBlock Text="{Binding ConnectionDetails}" Foreground="#D9DCF1" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0"/>
       <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#141824" BorderBrush="#343A53" BorderThickness="1" CornerRadius="16" Padding="16,14"><StackPanel><TextBlock Text="Public IP" Foreground="#8F96B8" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding PublicIp}" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
        <Border Grid.Column="2" Background="#141824" BorderBrush="#343A53" BorderThickness="1" CornerRadius="16" Padding="16,14"><StackPanel><TextBlock Text="Server IP" Foreground="#8F96B8" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding ConnectedServerIp}" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
       </Grid>
       <Button Height="60" Command="{Binding ToggleConnectionCommand}" Margin="0,22,0,0" Background="#5865F2"><TextBlock Text="{Binding ButtonContent}" FontSize="18" FontWeight="Bold"/></Button>
      </StackPanel>
      <Border Grid.Column="1" Width="116" Height="116" CornerRadius="24" Background="#11141D" BorderBrush="#C9CEE9" BorderThickness="5" HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="/Assets/logo.png" Width="78" Height="78"/></Border>
     </Grid>
     <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Padding="16" Background="#181B27" BorderBrush="#2D3144" BorderThickness="1" CornerRadius="20">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0"><TextBlock Text="VPN Mode" Foreground="#9EA4C7" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Choose the routing engine that fits your setup." Foreground="#7F87A9" FontSize="13" Margin="0,6,0,0"/><ComboBox ItemsSource="{Binding ConnectionOptions}" SelectedItem="{Binding SelectedConnectionOption}" DisplayMemberPath="DisplayName" Background="#24283B" Foreground="White" BorderBrush="#3B3D4F" BorderThickness="1" Padding="10,8" Margin="0,12,0,0"/><TextBlock Text="{Binding SelectedConnectionOption.Description}" Foreground="#A1A8C8" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
        <Border Grid.Row="2" Background="#141824" BorderBrush="#343A53" BorderThickness="1" CornerRadius="16" Padding="12"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsChinaModeSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="China Mode Quick Note" Foreground="White" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="설정 입력은 오른쪽 China Mode Setup 패널에서 진행합니다." Foreground="#95A0C6" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding ChinaModeState}" Foreground="#D8DCFF" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="{Binding OutlineProvisionStatus}" Foreground="#C7CBFF" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <Grid Grid.Row="0" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ServerLibraryTitle}" Foreground="White" FontSize="20" FontWeight="Bold" FontFamily="Bahnschrift SemiBold"/><TextBlock Text="{Binding ServerLibrarySubtitle}" Foreground="#8590B4" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Command="{Binding FetchServersCommand}" Background="#24283B" BorderBrush="#38405C" BorderThickness="1" Padding="14,8"><Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsChinaModeSelected}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="서버 목록 갱신" Foreground="#D8DCFF" FontSize="12" FontWeight="SemiBold"/></Button></Grid>
         <Grid Grid.Row="1"><ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"/><Border Background="#0F1220" BorderBrush="#303446" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,64,0,0" VerticalAlignment="Top"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsChinaModeSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="China Mode Notice" Foreground="White" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="중국 환경에서는 본인 소유 엔드포인트 사용을 권장합니다." Foreground="#A1A8C8" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border></Grid>
        </Grid>
       </Grid>
      </Border>
      <Border Grid.Column="2" Padding="18" Background="#181B27" BorderBrush="#2D3144" BorderThickness="1" CornerRadius="24"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsChinaModeSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="China Mode Setup" Foreground="White" FontSize="20" FontWeight="Bold" FontFamily="Bahnschrift SemiBold"/>
        <TextBlock Text="Outline Access Key, VLESS REALITY, Trojan TLS 중 하나를 선택해 직접 입력합니다." Foreground="#8590B4" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
        <Border Background="#0F1220" BorderBrush="#303446" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,14,0,0">
         <StackPanel>
          <TextBlock Text="Saved China Profiles" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
          <Grid Margin="0,10,0,0">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="96"/><ColumnDefinition Width="10"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
           <ComboBox Grid.Column="0" ItemsSource="{Binding SavedChinaProfiles}" SelectedItem="{Binding SelectedSavedChinaProfile}" DisplayMemberPath="Name" Background="#141824" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/>
           <Button Grid.Column="2" Command="{Binding CreateChinaProfileSlotCommand}" Height="42"><TextBlock Text="새 슬롯" FontSize="12" FontWeight="SemiBold"/></Button>
           <Button Grid.Column="4" Command="{Binding DeleteChinaProfileSlotCommand}" Height="42"><TextBlock Text="삭제" FontSize="12" FontWeight="SemiBold"/></Button>
          </Grid>
          <Grid Margin="0,10,0,0">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
           <TextBox Grid.Column="0" Text="{Binding ChinaModeProfileName, UpdateSourceTrigger=PropertyChanged}" Background="#141824" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/>
           <Button Grid.Column="2" Command="{Binding SaveChinaProfileSlotCommand}" Height="42"><TextBlock Text="슬롯 저장" FontSize="12" FontWeight="SemiBold"/></Button>
          </Grid>
         </StackPanel>
        </Border>
        <Grid Margin="0,16,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
         <ComboBox Grid.Column="0" ItemsSource="{Binding ChinaModeProfiles}" SelectedItem="{Binding SelectedChinaModeProfile}" DisplayMemberPath="DisplayName" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/>
         <Button Grid.Column="2" Command="{Binding ImportChinaProfileCommand}" Height="42"><TextBlock Text="가져오기" FontSize="12" FontWeight="SemiBold"/></Button>
         <Button Grid.Column="4" Command="{Binding ExportChinaProfileCommand}" Height="42"><TextBlock Text="내보내기" FontSize="12" FontWeight="SemiBold"/></Button>
        </Grid>
        <Grid Margin="0,10,0,0"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsOutlineProfileSelected}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Grid.Column="0" Text="{Binding OutlineApiUrl, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/><TextBox Grid.Column="2" Text="{Binding OutlineCertSha256, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/></Grid>
        <Grid Margin="0,10,0,0"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsOutlineProfileSelected}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><Grid Grid.Column="0"><TextBox Text="{Binding ChinaModeAccessKey, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"><TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOutlineAccessKeyVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox><PasswordBox Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10" helpers:PasswordBoxHelper.BindPassword="True" helpers:PasswordBoxHelper.BoundPassword="{Binding ChinaModeAccessKey, Mode=TwoWay}"><PasswordBox.Style><Style TargetType="PasswordBox"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsOutlineAccessKeyVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></PasswordBox.Style></PasswordBox></Grid><Button Grid.Column="2" Command="{Binding GenerateAccessKeyFromExistingServerCommand}" Height="42"><TextBlock Text="키 생성" FontSize="13" FontWeight="SemiBold"/></Button></Grid>
        <Grid Margin="0,10,0,0"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsOutlineProfileSelected}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="80"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBox Grid.Column="0" Text="{Binding OutlineSshHost, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/><TextBox Grid.Column="2" Text="{Binding OutlineSshUser, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/><TextBox Grid.Column="4" Text="{Binding OutlineSshKeyPath, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/><Button Grid.Column="6" Command="{Binding LoadExistingServerAccessInfoCommand}" Height="42"><TextBlock Text="정보 읽기" FontSize="13" FontWeight="SemiBold"/></Button></Grid>
        <Grid Margin="0,10,0,0"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsOutlineProfileSelected}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="80"/><ColumnDefinition Width="10"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBox Grid.Column="0" Text="{Binding OutlineProvisionHostname, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/><TextBox Grid.Column="2" Text="{Binding OutlineProvisionPort, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/><Button Grid.Column="4" Command="{Binding BootstrapOutlineServerCommand}" Height="42"><TextBlock Text="새 서버 구축" FontSize="13" FontWeight="Bold"/></Button></Grid>
        <Border Background="#0F1220" BorderBrush="#303446" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,14,0,0"><StackPanel>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="China Mode Summary" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="2" Command="{Binding TestChinaProfileCommand}" Height="34"><TextBlock Text="설정 테스트" FontSize="12" FontWeight="SemiBold"/></Button></Grid>
         <Grid Margin="0,12,0,0"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsVlessRealityProfileSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Grid.Row="0" Grid.Column="0" Text="{Binding VlessRealityServer, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/><TextBox Grid.Row="0" Grid.Column="2" Text="{Binding VlessRealityPort, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/><TextBox Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" Text="{Binding VlessRealityUuid, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/><TextBox Grid.Row="1" Grid.Column="2" Margin="0,10,0,0" Text="{Binding VlessRealityPublicKey, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/><TextBox Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" Text="{Binding VlessRealityServerName, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/><TextBox Grid.Row="2" Grid.Column="2" Margin="0,10,0,0" Text="{Binding VlessRealityShortId, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/><TextBox Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0" Text="{Binding VlessRealityFingerprint, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/></Grid>
         <Grid Margin="0,12,0,0"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTrojanProfileSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Grid.Row="0" Grid.Column="0" Text="{Binding TrojanServer, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/><TextBox Grid.Row="0" Grid.Column="2" Text="{Binding TrojanPort, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/><Grid Grid.Row="1" Grid.Column="0" Margin="0,10,0,0"><TextBox Text="{Binding TrojanPassword, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"><TextBox.Style><Style TargetType="TextBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTrojanPasswordVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox><PasswordBox Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10" helpers:PasswordBoxHelper.BindPassword="True" helpers:PasswordBoxHelper.BoundPassword="{Binding TrojanPassword, Mode=TwoWay}"><PasswordBox.Style><Style TargetType="PasswordBox"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsTrojanPasswordVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></PasswordBox.Style></PasswordBox></Grid><TextBox Grid.Row="1" Grid.Column="2" Margin="0,10,0,0" Text="{Binding TrojanServerName, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/><TextBox Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0" Text="{Binding TrojanFingerprint, UpdateSourceTrigger=PropertyChanged}" Background="#0F1220" Foreground="White" BorderBrush="#38405C" BorderThickness="1" Padding="12,10"/></Grid>
         <TextBlock Text="{Binding OutlineProvisionStatus}" Foreground="#C7CBFF" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding ConnectionDetails}" Foreground="#D7DCF5" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding ChinaModeProfileHint}" Foreground="#7DE7A0" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding SelectedConnectionOption.SetupHint}" Foreground="#8590B4" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
         <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Grid.Column="0" Command="{Binding ToggleOutlineAccessKeyVisibilityCommand}" Height="34"><TextBlock Text="Outline 키 보기/숨기기" FontSize="12" FontWeight="SemiBold"/></Button><Button Grid.Column="2" Command="{Binding ToggleTrojanPasswordVisibilityCommand}" Height="34"><TextBlock Text="Trojan 비밀번호 보기/숨기기" FontSize="12" FontWeight="SemiBold"/></Button></Grid>
        </StackPanel></Border>
       </StackPanel></ScrollViewer>
      </Border>
     </Grid>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
